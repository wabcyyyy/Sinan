        "photoSpots": [
          {
            "name": "东京都厅展望室",
            "tip": "晴天可拍到富士山与东京街景，靠窗逆光时用手机点测光在天空上",
            "bestTime": "上午 9:30-10:30"
          },
          {
            "name": "新宿中央公园草坪",
            "tip": "以都厅双塔为背景拍人物剪影，绿荫与建筑同框",
            "bestTime": "上午 11:00 前后"
          }
        ],
        "practicalNotes": [
          "都厅展望室需过安检，随身带好证件，人多时排队约十几分钟，尽量赶在上午人少时段。",
          "从新宿中央公园到歌舞伎町步行约二十分钟，长辈若觉疲劳可直接打车，省下体力留给用餐。",
          "点餐时可提前把「不吃肉、不吃鱼」写在纸上交给店员，日语沟通不畅时最省事。",
          "酒店可先寄存行李再出门，把重物放下后行程更轻松。"
        ],
        "dayOptions": [
          {
            "label": "全程步行版",
            "summary": "西口到歌舞伎町全部步行衔接，慢慢走、多休息。",
            "tradeoff": "省交通费但体力消耗大，长者膝盖不适时不适合。",
            "items": []
          },
          {
            "label": "打车衔接版",
            "summary": "都厅到歌舞伎町之间打车，其余步行。",
            "tradeoff": "更省力但增加交通支出，距离短时未必比走路快多少。",
            "items": []
          }
        ],
