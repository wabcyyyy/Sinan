# 本地环境变量示例（docker compose 用）
# 仅供 Compose 插值；后端完整配置模板在 travel-agent-python/.env.example。
# 推荐用 compose.setup.yml 初始化随机口令，并同步生成后端配置。
# 以下口令均为本地占位值；不要原样用于对外部署，也不要提交生成的 .env。
MYSQL_ROOT_PASSWORD=travel_dev_only
MYSQL_DB=travel_assistant
# 宿主机端口都只绑 127.0.0.1（见 docker-compose.yml）
MYSQL_PORT=3306
REDIS_PORT=6380
# compose 起的 Redis 强制带口令：里面放着 JWT 吊销黑名单与登录锁桶（R1-7）
REDIS_PASSWORD=change-me-before-any-nonlocal-use
# 可信代理网段：nginx 与后端同网络，按 bridge 段信任（R1-5）
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
