{
  "name": "travel-frontend-react",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/ai-coding.tsbuildinfo",
    "test:affected": "vitest related --run",
    "test:delivery": "node --test e2e/delivery-gate.test.mjs",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "preview": "vite preview",
    "test:unit": "vitest run && node --test e2e/delivery-gate.test.mjs",
    "e2e:golden": "node e2e/golden-path.mjs",
    "e2e:demo": "node e2e/demo-path.mjs",
    "theme:lint": "node scripts/theme-lint.mjs",
    "ep:lint": "node scripts/ep-allowlist.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "motion": "^14.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "playwright-core": "^1.63.0",
    "typescript": "~5.4.5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
