# Paste into the Sinan service Variables; references use these service names.
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_NAME=${{MySQL.MYSQLDATABASE}}
DB_USER=sinan
DB_PASSWORD=replace-with-the-schema-scoped-sinan-password
REDIS_URL=${{Redis.REDIS_URL}}
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-chars
AGENT_INTERNAL_TOKEN=replace-with-another-generated-random-secret
RAILWAY_EDGE_HEADERS=true
FRONTEND_SHELL_URL=http://127.0.0.1:8000/index.html
PORT=8000
RAILWAY_DOCKERFILE_PATH=Dockerfile.hosted
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=45
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_HEALTHCHECK_TIMEOUT_SEC=300
UA_CONTACT=replace-with-your-real-contact-email
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=replace-with-your-actual-model
LLM_API_KEY=replace-with-a-separate-trial-api-key
# Set actual provider prices before opening live AI. No price = blocked, not free.
# Format: {"https://api.deepseek.com|actual-model":{"input":0,"cached_input":0,"output":0}}
# Values above only illustrate shape; do NOT use zero prices for paid models.
LLM_PRICE_CNY_JSON={}
